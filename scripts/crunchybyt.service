[Unit]
Description=CrunchyByt — anime player for Tronbyt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these to match your Pi setup:
User=pi
Group=pi
Environment=CRUNCHYBYT_CONFIG=/etc/crunchybyt/config.toml
# yt-dlp lives in the venv's bin/, which isn't on systemd's default PATH.
# (The daemon also tries sys.executable's sibling as a fallback, but this
# keeps things obvious.)
Environment=PATH=/opt/crunchybyt/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/crunchybyt/venv/bin/crunchybyt-daemon
Restart=on-failure
RestartSec=5
# Hardening. ReadWritePaths only lists dirs we actually write to (logs go to
# journald). Adding a non-existent path here causes status=226/NAMESPACE.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/crunchybyt

[Install]
WantedBy=multi-user.target
